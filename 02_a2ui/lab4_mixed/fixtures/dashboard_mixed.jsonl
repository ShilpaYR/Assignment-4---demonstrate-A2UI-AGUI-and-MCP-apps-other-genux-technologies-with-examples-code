{"version":"1.0","updateComponents":{"surfaceId":"coffee_dashboard","components":[{"id":"root","component":"Column","children":["title","kpis","whatif","items_card","stock_card","close_btn"]},{"id":"title","component":"Text","text":"## Campus Coffee Cart - this week"},{"id":"kpis","component":"Row","children":["k_rev","k_cups","k_ticket"]},{"id":"k_rev","component":"Card","child":"k_rev_col"},{"id":"k_rev_col","component":"Column","children":["k_rev_label","k_rev_value"]},{"id":"k_rev_label","component":"Text","text":"Revenue","variant":"caption"},{"id":"k_rev_value","component":"Text","text":{"@call":"formatString","args":{"value":"### ${/kpis/revenue}"}}},{"id":"k_cups","component":"Card","child":"k_cups_col"},{"id":"k_cups_col","component":"Column","children":["k_cups_label","k_cups_value"]},{"id":"k_cups_label","component":"Text","text":"Cups sold","variant":"caption"},{"id":"k_cups_value","component":"Text","text":{"@call":"formatString","args":{"value":"### ${/kpis/cups}"}}},{"id":"k_ticket","component":"Card","child":"k_ticket_col"},{"id":"k_ticket_col","component":"Column","children":["k_ticket_label","k_ticket_value"]},{"id":"k_ticket_label","component":"Text","text":"Avg ticket","variant":"caption"},{"id":"k_ticket_value","component":"Text","text":{"@call":"formatString","args":{"value":"### ${/kpis/ticket}"}}},{"id":"items_card","component":"Card","child":"items_col"},{"id":"items_col","component":"Column","children":["items_title","items_list"]},{"id":"items_title","component":"Text","text":"#### Top items"},{"id":"items_list","component":"List","children":{"componentId":"item_row","path":"/items"}},{"id":"item_row","component":"Row","children":["item_name","item_cups","item_rev"]},{"id":"item_name","component":"Text","text":{"@path":"name"}},{"id":"item_cups","component":"Text","text":{"@call":"formatString","args":{"value":"${cups} cups"}},"variant":"caption"},{"id":"item_rev","component":"Text","text":{"@path":"revenue"}},{"id":"stock_card","component":"Card","child":"stock_col"},{"id":"stock_col","component":"Column","children":["stock_text","restock_btn","stock_status"]},{"id":"stock_text","component":"Text","text":{"@call":"formatString","args":{"value":"Beans on hand: **${/inventory/beans_kg} kg** (reorder at ${/inventory/reorder_kg} kg)"}}},{"id":"restock_label","component":"Text","text":"Reorder 10 kg of beans"},{"id":"restock_btn","component":"Button","child":"restock_label","variant":"primary","action":{"event":{"name":"restock_beans","context":{"kg":10,"beansNow":{"@path":"/inventory/beans_kg"}}}}},{"id":"stock_status","component":"Text","text":{"@path":"/inventory/status"},"variant":"caption"},{"id":"whatif","component":"HtmlFrame","@catalogId":"https://catalogs.genux.example/html/v1/catalog.json","title":"What-if price calculator","html":"<!doctype html>\n<html>\n<head>\n<style>\n  body { font: 14px/1.4 -apple-system, \"Segoe UI\", Roboto, sans-serif; margin: 0; padding: 12px; color: #1d1b16; }\n  h3 { margin: 0 0 8px; font-size: 15px; }\n  label { display: grid; grid-template-columns: 150px 1fr 70px; gap: 8px; align-items: center; margin: 6px 0; }\n  output { font-weight: 600; text-align: right; }\n  .result { margin-top: 10px; padding: 10px; border-radius: 8px; background: #f2e7dc; display: flex; gap: 18px; flex-wrap: wrap; }\n  .result b { font-size: 20px; display: block; }\n  .bar { height: 10px; background: #e3ded2; border-radius: 5px; margin-top: 8px; overflow: hidden; }\n  .bar > div { height: 100%; background: #2f7d4f; width: 0; transition: width .2s; }\n  button { margin-top: 10px; font: inherit; border: 0; border-radius: 6px; padding: 6px 12px; background: #7b4bb3; color: #fff; cursor: pointer; }\n</style>\n</head>\n<body>\n  <h3>Break-even calculator</h3>\n  <label>Price per cup <input id=\"price\" type=\"range\" min=\"2\" max=\"7\" step=\"0.05\" value=\"3.60\"><output id=\"priceOut\"></output></label>\n  <label>Cost per cup <input id=\"cost\" type=\"range\" min=\"0.5\" max=\"3\" step=\"0.05\" value=\"1.25\"><output id=\"costOut\"></output></label>\n  <label>Fixed weekly costs <input id=\"fixed\" type=\"range\" min=\"200\" max=\"2000\" step=\"10\" value=\"900\"><output id=\"fixedOut\"></output></label>\n  <div class=\"result\">\n    <div>Break-even cups / week<b id=\"cups\">-</b></div>\n    <div>Profit at 1,297 cups<b id=\"profit\">-</b></div>\n  </div>\n  <div class=\"bar\" title=\"this week's cups vs break-even\"><div id=\"progress\"></div></div>\n  <button id=\"apply\">Use this price</button>\n<script>\n  var SOLD = 1297;\n  function $(id) { return document.getElementById(id); }\n  function update() {\n    var p = +$(\"price\").value, c = +$(\"cost\").value, f = +$(\"fixed\").value;\n    $(\"priceOut\").textContent = \"$\" + p.toFixed(2);\n    $(\"costOut\").textContent = \"$\" + c.toFixed(2);\n    $(\"fixedOut\").textContent = \"$\" + f.toFixed(0);\n    var margin = p - c;\n    var cups = margin > 0 ? Math.ceil(f / margin) : Infinity;\n    $(\"cups\").textContent = isFinite(cups) ? cups.toLocaleString() : \"never\";\n    $(\"profit\").textContent = \"$\" + (SOLD * margin - f).toFixed(0);\n    $(\"progress\").style.width = isFinite(cups) ? Math.min(100, 100 * SOLD / cups) + \"%\" : \"0%\";\n  }\n  [\"price\", \"cost\", \"fixed\"].forEach(function (id) { $(id).addEventListener(\"input\", update); });\n  $(\"apply\").addEventListener(\"click\", function () {\n    genux.emit(\"apply_price\", { price: +$(\"price\").value, breakEvenCups: $(\"cups\").textContent });\n  });\n  update();\n</script>\n</body>\n</html>\n","caption":{"@path":"/whatif/status"},"allowedEvents":["apply_price"]},{"id":"close_label","component":"Text","text":"Close dashboard"},{"id":"close_btn","component":"Button","child":"close_label","variant":"borderless","action":{"event":{"name":"close_surface","context":{}}}}]}}
