    "@openuidev/lang-core": "1.2.0",
    "gpt-tokenizer": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
